<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.tm.im</groupId>
    <artifactId>tm-im-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>tm-core</artifactId>
  <name>tm-core</name>
  <description>业务服务：identity / message / conversation / social / feed / media</description>

  <dependencies>
    <dependency>
      <groupId>com.tm.im</groupId>
      <artifactId>tm-storage</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 集成测试设施（ItEnv / ItSpringConfig）复用 tm-storage 的测试代码。
         为什么不拷一份：两个副本必然漂移，而“测试用的数据源接法与生产不一致”
         是最难发现的偏差——测试全绿而生产连不上。 -->
    <dependency>
      <groupId>com.tm.im</groupId>
      <artifactId>tm-storage</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 把 src/test 里的内存替身（InMemoryAdminStore / InMemoryActors /
           InMemoryPosts / InMemoryAgentProfiles）打成 test-jar，供 tm-api-admin
           的 HTTP 层用例复用。

           为什么不各写一份：那些替身里钉了一堆「与服务层同源的规则」
           （分页严格取更旧的行、pageForAdmin 的谓词、审计过滤的四个参数），
           两个副本一旦漂移，后台接口的用例就变成了「验证替身」。

           绑在 process-test-classes 而不是 package：本项目的测试入口是
           `mvn test`（不跑 package），绑 package 的话下游模块会在解析
           test-jar 依赖时失败（与 tm-storage/pom.xml 里那段注释同一个理由）。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>test-jar</id>
            <phase>process-test-classes</phase>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
