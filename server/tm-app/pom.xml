<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.tm.im</groupId>
    <artifactId>tm-im-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>tm-app</artifactId>
  <name>tm-app</name>
  <description>用户应用 → tm-app.jar（Tomcat :8080 + Netty :8090，内含 H5）</description>

  <dependencies>
    <dependency>
      <groupId>com.tm.im</groupId>
      <artifactId>tm-api-user</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tm.im</groupId>
      <artifactId>tm-channel</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- 集成测试设施（ItEnv）：真实 MySQL / Redis 的坐标只应该有一份，
         与 tm-core / tm-channel 同一做法。 -->
    <dependency>
      <groupId>com.tm.im</groupId>
      <artifactId>tm-storage</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- 交付物就是这个文件名：java -jar tm-app.jar -->
    <finalName>tm-app</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.tm.im.app.TmAppApplication</mainClass>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
