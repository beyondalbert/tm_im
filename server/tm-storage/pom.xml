<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.tm.im</groupId>
    <artifactId>tm-im-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>tm-storage</artifactId>
  <name>tm-storage</name>
  <description>MyBatis-Plus 仓储实现 + ShardingSphere 分片接入</description>

  <dependencies>
    <dependency>
      <groupId>com.tm.im</groupId>
      <artifactId>tm-domain</artifactId>
    </dependency>

    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>

    <!-- ShardingSphere 以 JDBC 驱动方式接入（不是 Starter，见 DESIGN §3.3 陷阱 2） -->
    <dependency>
      <groupId>org.apache.shardingsphere</groupId>
      <artifactId>shardingsphere-jdbc</artifactId>
    </dependency>
    <!-- 分片功能本身。必须显式声明：shardingsphere-jdbc 不带任何特性实现，
         缺了它启动时报 "Invalid tag: !SHARDING"（误导性地指向 YAML）。
         版本由父 pom dependencyManagement 提供。 -->
    <dependency>
      <groupId>org.apache.shardingsphere</groupId>
      <artifactId>shardingsphere-sharding-core</artifactId>
    </dependency>
    <!-- 生产用 file:/etc/tm/sharding.yaml 时必须显式引入，否则启动报无法加载配置 -->
    <dependency>
      <groupId>org.apache.shardingsphere</groupId>
      <artifactId>shardingsphere-infra-url-absolutepath</artifactId>
    </dependency>
    <!-- 数据源连接池元数据（HikariCP 的 jdbcUrl->url 同义词映射）。
         缺失时 StorageUnit 里 standardProps.get("url") 为 null → NPE。
         版本由父 pom dependencyManagement 提供。 -->
    <dependency>
      <groupId>org.apache.shardingsphere</groupId>
      <artifactId>shardingsphere-infra-data-source-pool-hikari</artifactId>
    </dependency>
    <!-- 单机模式（ContextManagerBuilder 等 SPI）。版本由父 pom 管理。 -->
    <dependency>
      <groupId>org.apache.shardingsphere</groupId>
      <artifactId>shardingsphere-standalone-mode-repository-memory</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.shardingsphere</groupId>
      <artifactId>shardingsphere-authority-simple</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.shardingsphere</groupId>
      <artifactId>shardingsphere-parser-sql-engine-mysql</artifactId>
    </dependency>
    <!-- classpath: 形式的 url 加载器（开发用） -->
    <dependency>
      <groupId>org.apache.shardingsphere</groupId>
      <artifactId>shardingsphere-infra-url-classpath</artifactId>
    </dependency>

    <!-- ============================================================
         Redis（DESIGN §10.3）：本模块是它的唯一使用方 —— 序号源。
         声明在这里而不是 tm-core，是因为它是**基础设施适配层**的实现依赖：
         仓储实现用它，业务服务不应该知道自己底下是 Redis。
         （注意：tm-core 依赖 tm-storage，所以 Redis 的类对 tm-core 依然可见；
           这条声明的意义是「谁用就谁声明」，避免出现无人使用的依赖声明。）
         ============================================================ -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- 版本由 Spring Boot BOM 管理 -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 把 src/test 里的集成测试设施（ItEnv / ItSpringConfig）打成 test-jar，
           供 tm-core 的集成测试复用：消息写入的验证需要真实的
           ShardingSphere 数据源 + 真实 Redis，而那套接法只应该有一份。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>test-jar</id>
            <!-- 常规写法是绑在 package，但本项目的集成测试入口是
                 `mvn ... test -Pit`（不跑 package）。绑在 package 的话，
                 反应堆里的 tm-core 会在解析 test-jar 依赖时失败：
                   Could not resolve dependencies ... tm-storage:jar:tests
                 而报错完全不会指向“阶段不对”。绑到 test 编译刚结束那一刻，
                 两种命令（test / package）都能跑。 -->
            <phase>process-test-classes</phase>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
