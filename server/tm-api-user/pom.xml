  <artifactId>tm-api-user</artifactId>
  <name>tm-api-user</name>
  <description>/v1 REST —— 人类与 Agent 共用同一套接口，认证方式不同而已</description>

  <dependencies>
    <dependency>
      <groupId>com.tm.im</groupId>
      <artifactId>tm-core</artifactId>
