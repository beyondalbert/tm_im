# ============================================================================
# tm_im 本地连接信息（M0 用）
#
# 用法：复制本文件为 deploy/conf/local-conn.env 然后填空。
#      copy deploy\conf\local-conn.env.example deploy\conf\local-conn.env
#
# 该文件已被 .gitignore 保护（*.env），不会提交。
# 只填你知道的；不确定的留空，检查脚本会给出提示。
# ============================================================================

# ---------------------------- MySQL ----------------------------
# 必填
MYSQL_HOST=
# 当前实例是 MySQL 8.4.4，监听 13306；同主机 3306 上还有一个 5.7.44 旧实例。
# 误填 3306 的后果不是“连不上”，而是连上后建表才报 ERROR 1273 Unknown collation
# （建表脚本用的是 utf8mb4_0900_ai_ci，5.7 没有这个排序规则）。
MYSQL_PORT=13306
MYSQL_USER=
MYSQL_PASSWORD=

# 建库用（可选）：如果你已建好库，填库名即可；留空则默认 tm_im
# 注意：分片配置需要 1 个逻辑库 + 16 张 message 物理表，见 docs/DESIGN.md
# 库的排序规则必须是 utf8mb4_0900_ai_ci；若库已存在且规则不符，
# bootstrap_db.py 会在 0 张表时自动 ALTER，有表则会停下来要求 DBA 处理。
MYSQL_DATABASE=tm_im

# 可选：如果允许我自动建库建表，设为 true
MYSQL_ALLOW_DDL=false

# 可选：多数据源（默认单库）。格式：host:port:user:password:db，多个用逗号分隔
MYSQL_EXTRA_DATASOURCES=

# 可选：连接参数
MYSQL_USE_SSL=false
MYSQL_SERVER_TIMEZONE=Asia/Shanghai

# ---------------------------- Redis ----------------------------
# 必填
REDIS_HOST=
REDIS_PORT=6379

# 可选：无密码留空
REDIS_PASSWORD=
REDIS_DB=0

# 可选：是否集群模式（true/false）
REDIS_CLUSTER=false

# ---------------------------- 备注 ----------------------------
# 下面留给你补充任何上下文，例如：
#   - 内网/公网可达性说明
#   - 是否有 IP 白名单需要我加
#   - 是否共享实例（我需要避免 flushdb 等破坏性操作）
#   - 版本号
NOTES=
