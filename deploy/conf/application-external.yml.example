# ============================================================
# tm_im 外部服务配置（模板）
# ------------------------------------------------------------
# 复制为 application-external.yml 并填入/导出真实值（勿提交仓库）
#
# 启动：
#   java -jar tm-app.jar \
#     --spring.config.additional-location=file:/etc/tm/ \
#     --sharding.url=jdbc:shardingsphere:absolutepath:/etc/tm/sharding.yaml
#
# 所有敏感值走环境变量，本文件只留占位符。
# ============================================================

spring:
  # ---------- 数据源：交给 ShardingSphere 驱动接管 ----------
  # 关键：driver-class-name 必须是 ShardingSphereDriver，而非 mysql 驱动
  datasource:
    driver-class-name: org.apache.shardingsphere.driver.ShardingSphereDriver
    url: jdbc:shardingsphere:absolutepath:${TM_SHARDING_CONF:/etc/tm/sharding.yaml}

  # ---------- Redis（外部提供） ----------
  data:
    redis:
      host: ${TM_REDIS_HOST}
      port: ${TM_REDIS_PORT:6379}
      password: ${TM_REDIS_PASSWORD:}
      database: ${TM_REDIS_DB:0}
      timeout: 3000ms
      connect-timeout: 3000ms
      lettuce:
        pool:
          max-active: 32
          max-idle: 16
          min-idle: 4
          max-wait: 2000ms
        shutdown-timeout: 200ms

  # ---------- 文件上传（图片） ----------
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 12MB

server:
  port: ${TM_HTTP_PORT:8080}
  tomcat:
    threads:
      max: 400
      min-spare: 40
    max-connections: 10000

# ============================================================
# tm_im 自身配置
# ============================================================
tm:
  # ---------- Netty 长连接 ----------
  netty:
    enabled: true
    port: ${TM_NETTY_PORT:8090}
    boss-threads: 1
    worker-threads: 0          # 0 = CPU 核数 × 2
    business-threads: 32       # 业务线程池（绝不在 IO 线程做 DB）
    business-queue-capacity: 20000
    # 心跳：读空闲 30s 发 ping；60s 未响应告警；90s 断开
    heartbeat-idle-seconds: 30
    heartbeat-timeout-seconds: 90
    # 握手超时：连上之后多久没完成 AUTH 就断开（04-realtime.md §5.2）
    # 它覆盖两个阶段并且**共享同一个预算**：一个字节都没发 → 直接关
    # （此时承载方式未知，服务端无法保证对方能读懂任何字节）；
    # 已分流但没发 AUTH → 先回 40101 再关。
    auth-timeout-ms: 5000
    # 单帧字节上限。必须 < 16MB：同端口分流靠「长度前缀首字节为 0x00」这个判据，
    # 长度达到 16MB 后首字节就不再是 0x00，判据失效 —— 启动时会校验，越界直接起不来。
    max-frame-bytes: 1048576
    # 写缓冲水位（背压控制，超过高水位则丢弃非关键帧）
    write-buffer-high-water-mark: 65536
    write-buffer-low-water-mark: 32768
    # 单连接每秒最大帧数（防刷）
    max-frames-per-second: 200
    max-connections: 200000
    # 优雅停机：停止接受新连接后，等待写缓冲刷出的上限
    graceful-shutdown-millis: 5000

  # ---------- 身份与令牌 ----------
  identity:
    # JWT 签名密钥（HS256，至少 32 字节）。**必须由部署方提供**，
    # 代码里没有默认值：有默认值就等于仓库里躺着一把能用的钥匙。
    # 轮换方式：新密钥上线后旧 token 一律验签失败（客户端会收到 40102/40103，
    # 按「重新登录」处理即可），因此不需双密钥并行期。
    jwt-secret: ${TM_JWT_SECRET}
    # 访问令牌有效期。短有效期 + 鉴权时每次从库里读账号状态 = 封禁的最坏生效延迟
    access-token-ttl: 2h

  # ---------- 时区口径 ----------
  time:
    # 库里 DATETIME(3) 列映射为**不带时区**的 LocalDateTime，
    # 转成协议里的 created_at_ms 必须知道它属于哪个时区。
    # 本值必须与 sharding.yaml 里 jdbcUrl 的 serverTimezone 一致，
    # 否则时间会整体偏移几小时（消息照常收发、排序也对，只有显示的时间是错的）。
    zone: Asia/Shanghai

  # ---------- 媒体（图片）存储 ----------
  storage:
    # local | oss | s3
    type: ${TM_MEDIA_TYPE:local}
    media-root: ${TM_MEDIA_ROOT:./data/media}
    media-public-base: ${TM_MEDIA_BASE:http://localhost:8080/v1/media}
    # OSS/S3 预留（type 非 local 时使用）
    endpoint: ${TM_OSS_ENDPOINT:}
    bucket: ${TM_OSS_BUCKET:}
    access-key: ${TM_OSS_AK:}
    secret-key: ${TM_OSS_SK:}

  # ---------- Snowflake 节点标识（多实例必须各不相同！） ----------
  # 刻意**不**给默认值：`${TM_WORKER_ID:1}` 这种写法会让每个实例都拿到 1，
  # 多实例部署时节点号相撞 → 生成的 ID 也相撞 → 主键冲突。
  # 留空时服务端会退化为「按主机名哈希取节点号」并打 WARN，
  # 单机开发可以省事，生产请显式注入（每实例不同）。
  snowflake:
    worker-id: ${TM_WORKER_ID:}
    datacenter-id: ${TM_DC_ID:}

  # ---------- 消息与扇出 ----------
  message:
    # 超过该人数转为读扩散（不再逐成员写扩散）
    write-fanout-threshold: 500
    # 离线消息保留天数
    offline-retention-days: 30
    # 单会话消息拉取上限
    max-pull-size: 200

  # ---------- Agent 风控 ----------
  # 注：「非好友不能发消息」是硬规则（§11.6），不在此配置
  # 这里只管速率与配额（第二道防线）
  agent:
    default-rate-limit-per-minute: 60
    default-daily-quota: 5000
    # 好友请求也限流，防 Agent 批量骚扰
    friend-request-daily-quota: 100
    webhook-timeout-ms: 5000
    webhook-max-retry: 3
    # 签名头名称
    signature-header: X-TM-Signature

  # ---------- 好友关系（单聊硬前置，§11.6） ----------
  friend:
    # 好友集缓存 TTL（内存，加/删好友时主动失效）
    cache-ttl-seconds: 1800
    # 好友请求过期天数
    request-expire-days: 7
    # 是否允许被拉黑者再次发起请求
    allow-request-after-block: false

  # ---------- 广场 ----------
  feed:
    # 好友动态加权（分数越高越靠前）
    friend-boost: 524288
    # 大 V 阈值：粉丝数超过则改读扩散
    celebrity-threshold: 10000
    page-size: 20

logging:
  level:
    root: INFO
    com.tm.im: ${TM_LOG_LEVEL:INFO}
    # 调试分片路由时打开
    org.apache.shardingsphere: INFO
